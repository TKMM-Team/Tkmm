<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ext="using:Tkmm.Markup"
             xmlns:vm="clr-namespace:Tkmm.Wizard.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:TkmmModeSelectionPageContext"
             x:Class="Tkmm.Wizard.Pages.TkmmModeSelectionPage">
    <StackPanel Spacing="8">
        <TextBlock Text="{ext:Locale SetupWizard_TkmmMode_Description}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <RadioButton GroupName="tkmmMode"
                     IsChecked="{Binding IsEmulator}"
                     Content="{ext:Locale SetupWizard_TkmmMode_Emulator}" />
        <RadioButton GroupName="tkmmMode"
                     IsChecked="{Binding IsSwitch}"
                     Content="{ext:Locale SetupWizard_TkmmMode_NintendoSwitch}" />
        <RadioButton GroupName="tkmmMode"
                     IsChecked="{Binding IsHybrid}"
                     Content="{ext:Locale SetupWizard_TkmmMode_Both}" />
    </StackPanel>
</UserControl>